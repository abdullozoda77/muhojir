# Copy to .env and fill in. Without .env the project still runs on a laptop (SQLite, emails in the console).
SECRET_KEY=change-me
DEBUG=True

# SQLite by default; PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://muhojir:password@localhost:5432/muhojir

# Emails with the sign-up and password codes (Gmail: the address and a 16-letter app password from
# https://myaccount.google.com/apppasswords). While these are empty, letters are only printed in the console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Server only: Redis for live notifications between processes, and the Celery queue.
REDIS_URL=
CELERY_BROKER_URL=

# AI assistant: one key is enough (Gemini https://aistudio.google.com/apikey or Claude https://console.anthropic.com).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Air tickets: live prices from Aviasales. A free token from https://www.travelpayouts.com (Profile -> API token).
# Without it the tickets page shows the airports and opens the search on aviasales.ru.
TRAVELPAYOUTS_TOKEN=

# Sign in with Google: OAuth client ID (type "Web application") from https://console.cloud.google.com/auth/clients.
# While it is empty, the Google button is hidden.
GOOGLE_CLIENT_ID=
